{
  "name": "@cdlab/jsc",
  "version": "0.0.0",
  "description": "Compile JavaScript to WebAssembly and run it in the browser or Node.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "wasm/jsc_wasm.js",
    "wasm/jsc_wasm_bg.wasm",
    "wasm/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "ensure-wasm": "bash ../../scripts/ensure-wasm.sh",
    "build": "bun run ensure-wasm && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && vitest run",
    "lint": "biome check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
